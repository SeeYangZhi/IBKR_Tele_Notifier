# Deploy target for ./deploy.sh — copy to deploy/deploy.env and edit.
# deploy/deploy.env is gitignored; it holds no secrets, only host coordinates.
#
#   cp deploy/deploy.env.example deploy/deploy.env

# How deploy.sh reaches the host: "ssh" (any host) or "gcloud" (GCE VM).
TRANSPORT=ssh

# --- TRANSPORT=ssh -----------------------------------------------------------
# Anything your ssh/scp understands, including a ~/.ssh/config Host alias.
SSH_TARGET=user@your-host.example.com

# --- TRANSPORT=gcloud --------------------------------------------------------
# GCE instance name and zone. GCP_PROJECT is optional (defaults to the active
# gcloud project).
GCE_INSTANCE=
GCE_ZONE=
GCP_PROJECT=

# --- Remote layout -----------------------------------------------------------
# Where setup.sh installed the uv project on the host. Must match the path in
# the rendered systemd units.
REMOTE_DIR=/home/youruser/ibkr-notifier
