# Copy to .env and fill in. Keep it chmod 600 — it holds bot tokens.
#   cp env.example .env && chmod 600 .env

# --- Telegram (required) -----------------------------------------------------
# Bot token from @BotFather; channel id from getUpdates (channels are -100…).
# The bot must be an admin of the channel to post.
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
TELEGRAM_CHAT_ID=-1001234567890

# --- IB Gateway --------------------------------------------------------------
IB_HOST=127.0.0.1
IB_PORT=4001
# Must equal Gateway's "Master API client ID" so you receive fills from ALL
# sources (manual, API, TradingView routed to IBKR).
IB_CLIENT_ID=10

# --- Daily summary -----------------------------------------------------------
# Local time HH:MM for the open-positions snapshot. Leave blank to disable.
# "Local" means the service's TZ (set per-unit by deploy/setup.sh).
DAILY_SUMMARY_TIME=17:00

# Optional label appended to timestamps, e.g. SGT / ET. Useful because tzdata
# renders some zones as bare offsets ("+08"). Leave blank for no label.
TZ_LABEL=

# --- Ops channel -------------------------------------------------------------
# Health/error alerts ("summary skipped: not connected", Telegram failures,
# forwarded ERROR logs) go here instead of the production channel, keeping the
# trade channel purely trade-facing. Typically a second bot + a private channel.
# Leave blank to send ops messages to the production channel.
OPS_BOT_TOKEN=
OPS_CHAT_ID=

# Comma-separated Telegram user IDs allowed to DM the ops bot commands.
# Channel posts carry no user identity, so anyone who can post in OPS_CHAT_ID
# can run ops commands — see SECURITY.md before adding people to that channel.
OPS_ALLOWED_USER_IDS=

# Client id for the ops bot's brief /positions connection. Must differ from
# IB_CLIENT_ID — two API clients may not share an id.
OPS_CLIENT_ID=12

# systemd unit names, if you renamed the services.
# GATEWAY_UNIT=ibc-gateway
# NOTIFIER_UNIT=ibkr-notifier

# --- State -------------------------------------------------------------------
# Where the notifier persists already-sent fill execIds (for catch-up across
# restarts). Defaults to seen_execids.json next to the script.
# STATE_FILE=/home/youruser/ibkr-notifier/seen_execids.json
# Cap on retained execIds (newest kept). Default 5000.
# STATE_MAX_IDS=5000

# --- Testing -----------------------------------------------------------------
# Keep a separate .env.test (chmod 600) with the TEST bot token + TEST channel
# id, a distinct IB_CLIENT_ID, and its own STATE_FILE, then run against it:
#   ENV_FILE=/path/to/.env.test uv run python ibkr_telegram_notifier.py
# ENV_FILE overrides which dotenv file is loaded; unset uses .env (production).
